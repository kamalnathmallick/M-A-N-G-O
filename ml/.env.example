# MangoSense Python ML Service Configuration
# Copy this file to `.env` in ml/ — main.py calls load_dotenv() at startup.
# Every key below is read by main.py (os.getenv) and passed into the
# predictor/fusion pipelines; none are dead.

# HTTP binding (used when running `python main.py`; uvicorn CLI flags override)
ML_PORT=8000
ML_HOST=0.0.0.0

# Paths (relative to ml/)
MODEL_CONFIG=config/model_config.yaml
CNN_WEIGHTS_PATH=models/mangosense_cnn.pth
YIELD_MODEL_PATH=models/yield_model.pkl

# Inference device: cpu | cuda  (empty/unset = auto-detect)
DEVICE=cpu

# Overrides preprocessing.blur_laplacian_threshold for the quality gate
# (unset = use the value from config/model_config.yaml)
BLUR_THRESHOLD=60.0
