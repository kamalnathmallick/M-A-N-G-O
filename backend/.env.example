# Backend Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGO_URI=mongodb://127.0.0.1:27017/mangosense

# JWT Secret for Authentication
# REQUIRED in production — the server refuses to start without it.
# The value below is a development placeholder only.
JWT_SECRET=mangosense_jwt_secret_dev_key_2026_xyz
JWT_EXPIRES_IN=7d

# Machine Learning Service (FastAPI)
ML_SERVICE_URL=http://localhost:8000

# CORS Allowed Origins (comma-separated allow-list; localhost dev origins are
# always allowed — anything else is blocked)
CORS_ORIGIN=http://localhost:5173

# Upload Limit in Bytes (10MB)
MAX_FILE_SIZE=10485760

# Weather provider: 'mock' (offline demo data, always flagged isDemo: true)
# or 'openmeteo' (live keyless API at https://open-meteo.com — no API key needed)
WEATHER_PROVIDER=mock
# Coordinates + label used by the openmeteo provider (defaults: Ratnagiri, IN)
OPENMETEO_LATITUDE=16.25
OPENMETEO_LONGITUDE=73.38
OPENMETEO_LOCATION_NAME=Open-Meteo (farm coordinates)
