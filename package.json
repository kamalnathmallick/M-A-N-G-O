{
  "name": "mangosense-root",
  "version": "1.0.0",
  "private": true,
  "description": "MangoSense — Full-Stack Smart Agriculture Mango Flower Bud & Yield Prediction System",
  "scripts": {
    "start:frontend": "npm --prefix frontend run dev",
    "start:backend": "npm --prefix backend run dev",
    "start:ml": "cd ml && venv\\Scripts\\python.exe -m uvicorn main:app --port 8000",
    "start:mongo": "node scripts/start-mongo.js",
    "build:frontend": "npm --prefix frontend run build",
    "test:backend": "npm --prefix backend test",
    "test:ml-eval": "cd ml && venv\\Scripts\\python.exe evaluation/evaluate.py",
    "docs:build": "node scripts/build-docs.mjs"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.4"
  }
}
